# Portal Hub Configuration
# The WebSocket server URL that clients will connect to
PUBLIC_PORTAL_HUB_URL=http://localhost:5173/portal-hub

# CORS Configuration
# Comma-separated list of allowed origins for WebSocket connections
# In production, set this to your actual domain(s)
# Example: https://dimm-city-portal.com,https://www.dimm-city-portal.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Session Configuration (Optional)
# Maximum number of commands to store per session
MAX_COMMANDS_PER_SESSION=10000

# Session timeout in milliseconds (default: 24 hours)
SESSION_TIMEOUT_MS=86400000

# Rate Limiting Configuration (Optional)
# These values control how many requests can be made within specific time windows
# Adjust these values based on your server capacity and expected usage patterns

# Session creation: number of sessions per hour per IP
RATE_LIMIT_SESSION_CREATION=5

# Session join: number of join attempts per hour per IP
RATE_LIMIT_SESSION_JOIN=10

# Dice rolls: number of rolls per minute per user
RATE_LIMIT_DICE_ROLLS=60

# Editor commands: number of commands per minute per user
RATE_LIMIT_COMMANDS=100

# Password attempts: number of failed attempts per 15 minutes per IP
RATE_LIMIT_PASSWORD_ATTEMPTS=5
