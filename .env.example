# Portal Hub Configuration
# The WebSocket server URL that clients will connect to
PUBLIC_PORTAL_HUB_URL=http://localhost:5173/portal-hub

# Server Configuration
# Port for the server to listen on (default: 3000)
PORT=3000

# Host to bind to (use 0.0.0.0 for Docker, localhost for local dev)
HOST=0.0.0.0

# Node environment (development, production)
NODE_ENV=production

# CORS Configuration
# Comma-separated list of allowed origins for WebSocket connections
# In production, set this to your actual domain(s)
# Example: https://dimm-city-portal.com,https://www.dimm-city-portal.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Session Configuration
# Maximum number of commands to store per session
MAX_COMMANDS_PER_SESSION=10000

# Session timeout in seconds (default: 24 hours = 86400 seconds)
SESSION_TTL=86400

# Maximum number of concurrent sessions
MAX_SESSIONS=100

# Maximum players per session
MAX_PLAYERS_PER_SESSION=10

# Enable/disable public session browser
ENABLE_SESSION_BROWSER=true

# Database Configuration
# Path to SQLite database file
SQLITE_DB_PATH=./data/sessions.db

# Cleanup interval for expired sessions in milliseconds (default: 1 hour)
CLEANUP_INTERVAL=3600000

# Logging Configuration
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Rate Limiting Configuration
# These values control how many requests can be made within specific time windows
# Adjust these values based on your server capacity and expected usage patterns

# Session creation: number of sessions allowed per duration
RATE_LIMIT_SESSION_CREATION_POINTS=5
RATE_LIMIT_SESSION_CREATION_DURATION=3600

# Session join: number of join attempts allowed per duration
RATE_LIMIT_SESSION_JOIN_POINTS=10
RATE_LIMIT_SESSION_JOIN_DURATION=3600

# Dice rolls: number of rolls allowed per duration
RATE_LIMIT_DICE_ROLL_POINTS=60
RATE_LIMIT_DICE_ROLL_DURATION=60

# Editor commands: number of commands allowed per duration
RATE_LIMIT_COMMAND_POINTS=100
RATE_LIMIT_COMMAND_DURATION=60

# Password attempts: number of failed attempts allowed per duration
RATE_LIMIT_PASSWORD_ATTEMPTS_POINTS=5
RATE_LIMIT_PASSWORD_ATTEMPTS_DURATION=900

# Docker-ready configuration note:
# When running with Docker Compose, these variables can be overridden
# in docker-compose.yml or by creating a .env file in the project root.
